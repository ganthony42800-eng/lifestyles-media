/* ép. 20 — grand dauphin en particules, eau de nuit. Accroche : gros plan sur la tête, un œil ouvert qui brille → tampon VRAI →
   vue de face : hologramme du cerveau au-dessus de la tête, une moitié éveillée (cyan, ondes rapides) et une moitié endormie
   (violet, ondes lentes), un fil de lumière croisé relie la moitié éveillée à l'œil ouvert du côté opposé → les moitiés se relaient →
   le groupe nage, l'un remonte respirer (bulles) → nuance : la mère et son petit, l'œil du petit tourné vers elle → ép. 21. */
S.background=new THREE.Color('#020713');
const ry=(v,a)=>[v[0]*Math.cos(a)+v[2]*Math.sin(a),v[1],-v[0]*Math.sin(a)+v[2]*Math.cos(a)];
const rz=(v,a)=>[v[0]*Math.cos(a)-v[1]*Math.sin(a),v[0]*Math.sin(a)+v[1]*Math.cos(a),v[2]];
const LD=nrm([0.1,1.0,0.35]);
function shade(n,base){const d=Math.max(0,n[0]*LD[0]+n[1]*LD[1]+n[2]*LD[2]);const k=0.32+0.9*d;return [base[0]*k,base[1]*k,base[2]*k];}

/* ---------- eau : neige marine, rayons de lune, surface ---------- */
const NSN=2600;const SNOW=dyn(NSN,1.5);const SNU=[];{const R=mulberry32(2020);for(let i=0;i<NSN;i++)SNU.push([(R()*2-1)*5,-2.2+R()*4.4,-4.5+R()*6,R()]);}
const NRAY=3200;const RAYS=dyn(NRAY,2.2);const RAU=[];{const R=mulberry32(2021);for(let i=0;i<NRAY;i++)RAU.push([i%8,R(),R()]);}
const NSU=5200;const SURF=dyn(NSU,2.0);const SUU=[];{const R=mulberry32(2022);for(let i=0;i<NSU;i++)SUU.push([(R()*2-1)*6,-5+R()*6.5,R()]);}
const SURFY=1.35;
const NBU=420;const BUB=dyn(NBU,2.4);const BUU=[];{const R=mulberry32(2023);for(let i=0;i<NBU;i++)BUU.push([R(),R(),R(),R()]);}

/* ---------- dauphin (géométrie partagée) ---------- */
const OR=mulberry32(2024);
const NBO=9000,NRO=900,NDF=900,NPF=1000,NFL=1400,NEY=360;
const NDO=NBO+NRO+NDF+NPF+NFL+NEY;
const BOU=[];for(let i=0;i<NBO;i++)BOU.push([OR(),OR()*TAU,OR()]);
const ROU=[];for(let i=0;i<NRO;i++)ROU.push([OR(),OR()*TAU]);
const tri=()=>{let a=OR(),b=OR();if(a+b>1){a=1-a;b=1-b;}return [a,b];};
const DFU=[];for(let i=0;i<NDF;i++)DFU.push(tri());
const PFU=[];for(let i=0;i<NPF;i++)PFU.push([i%2,...tri()]);
const FLU=[];for(let i=0;i<NFL;i++)FLU.push([i%2,...tri()]);
const EYU=[];for(let i=0;i<NEY;i++)EYU.push([i%2,OR()*TAU,Math.sqrt(OR())]);
const bx=u=>mix(-0.88,0.70,u);
const brad=u=>0.185*Math.pow(Math.sin(Math.PI*clamp(Math.pow(u,0.8))),0.8)+0.018;
const TRI=(A,Bv,C,a,b)=>[A[0]+(Bv[0]-A[0])*a+(C[0]-A[0])*b,A[1]+(Bv[1]-A[1])*a+(C[1]-A[1])*b,A[2]+(Bv[2]-A[2])*a+(C[2]-A[2])*b];
const DORS=[0.24,0.36,0.52],BELLY=[0.62,0.70,0.80];
const EYE_U=0.86;
function mkD(){return dyn(NDO,1.1);}
/* P : pos, yaw, pitch, sc, ph (phase de nage), amp, eyeL, eyeR (0 fermé → 1 ouvert, L = côté −z), glow */
function buildDolphin(D,P,t){
  const {pos,yaw,pitch,ph,amp,eyeL,eyeR,glow}=P;const S0=P.sc||1;let n=0;
  const und=x=>amp*Math.pow(clamp((0.45-x)/1.5),1.8)*Math.sin(ph-2.6*x);
  const toW=v=>{let w=[v[0],v[1]+und(v[0]),v[2]];w=rz(w,pitch);w=ry(w,yaw);return add(pos,sc(w,S0));};
  const put=(p,c,s)=>{D.p.set(toW(p),n*3);D.c.set(sc(c,glow*0.55),n*3);D.z[n]=(s||1.1)*S0;n++;};
  const col=(ca)=>lerp3(BELLY,DORS,sm((ca+0.25)/0.6));
  for(const [u,a,q] of BOU){const r=brad(u);const ca=Math.cos(a),sa=Math.sin(a);
    const x=bx(u),y=r*1.05*ca-0.02*(1-u),z=r*0.92*sa;const nn=nrm([0,ca,sa]);put([x,y,z],sc(shade(nn,col(ca)),0.9+0.1*q),1.15);}
  for(const [v,a] of ROU){const r=0.045*(1-0.45*v);const x=mix(0.66,0.92,v);put([x,-0.045+r*Math.cos(a)*0.8,r*Math.sin(a)],shade(nrm([0,Math.cos(a),Math.sin(a)]),col(Math.cos(a))),1.05);}
  {const r=brad(0.5);for(const [a,b] of DFU){put(TRI([-0.12,r*0.95,0],[0.16,r*0.92,0],[-0.20,r+0.21,0],a,b),sc(DORS,0.85),1.05);}}
  for(const [s,a,b] of PFU){const sd=s?1:-1;put(TRI([0.30,-0.07,sd*0.13],[0.20,-0.09,sd*0.14],[0.04,-0.20,sd*0.32],a,b),sc(DORS,0.8),1.0);}
  for(const [s,a,b] of FLU){const sd=s?1:-1;put(TRI([-0.86,0,0],[-1.12,0.02,sd*0.30],[-1.03,0,sd*0.03],a,b),sc(DORS,0.8),1.0);}
  // yeux : disque lumineux (ouvert) ou fente sombre (fermé)
  {const r=brad(EYE_U);const ex=bx(EYE_U)-0.02;
   for(const [s,a,rr] of EYU){const sd=s?1:-1;const open=s?eyeR:eyeL;const R0=0.024;
     const y=0.015+Math.sin(a)*rr*R0*mix(0.12,1,open),xx=ex+Math.cos(a)*rr*R0;const z=sd*(r*0.92+0.006);
     const k=mix(0.25,1.15,open)*(rr<0.45?1.25:1);put([xx,y,z],open>0.05?[0.55*k,0.95*k,1.2*k]:[0.05,0.06,0.08],open>0.05?1.2:0.9);}}
  upd(D);
  return {eyeL:toW([bx(EYE_U),0.015,-(brad(EYE_U)*0.92)]),eyeR:toW([bx(EYE_U),0.015,brad(EYE_U)*0.92]),head:toW([0.45,0.42,0]),toW};
}
const DO1=mkD(),DO2=mkD(),DO3=mkD();

/* ---------- hologramme du cerveau : deux moitiés ---------- */
const NHM=2600;const BRAIN=dyn(NHM*2,1.4);const BRU=[];{const R=mulberry32(2025);for(let i=0;i<NHM*2;i++){const th=Math.acos(2*R()-1),ph=R()*TAU;BRU.push([i<NHM?-1:1,th,ph,R()]);}}
const NLK=260;const LINK=dyn(NLK,2.0);
let BR_ON=0;
/* awakeR : 1 = moitié droite éveillée (+z local) ; 0 = moitié gauche éveillée */
function buildBrain(G,t,awakeR,on){
  let n=0;const c=[0.45,0.40,0];
  for(const [side,th,ph,q] of BRU){
    const aw=side>0?awakeR:1-awakeR;
    const fold=1+0.07*Math.sin(th*9+ph*5)+0.04*Math.sin(th*17-ph*7);
    let x=Math.cos(th)*0.20*fold,y=Math.sin(th)*Math.cos(ph)*0.12*fold,z=Math.sin(th)*Math.sin(ph)*0.085*fold;
    if(z*side<0)z*=0.25;                     // face interne aplatie (scissure)
    y=Math.abs(y)*(y>0?1:0.55)*Math.sign(y);
    const p=[c[0]+x,c[1]+y,c[2]+side*0.075+z];
    // éveillé : ondes rapides et fines ; endormi : grandes ondes lentes
    const wf=0.5+0.5*Math.sin(t*9-x*40+q*2),ws=0.5+0.5*Math.sin(t*1.6-x*9);
    const kA=0.35+0.55*Math.pow(wf,3),kS=0.18+0.45*Math.pow(ws,2);
    const cA=[0.25*kA,0.95*kA,1.25*kA],cS=[0.55*kS,0.30*kS,1.05*kS];
    BRAIN.p.set(on>0?G.toW(p):[0,-99,0],n*3);BRAIN.c.set(sc(lerp3(cS,cA,aw),on),n*3);n++;}
  upd(BRAIN);
  // fil croisé : moitié éveillée → œil du côté opposé
  const from=G.toW([0.45,0.36,awakeR>0.5?0.10:-0.10]);const to=awakeR>0.5?G.eyeL:G.eyeR;const mid=add(sc(add(from,to),0.5),[0,0.04,0]);
  for(let i=0;i<NLK;i++){const s=i/(NLK-1);const a=add(sc(from,(1-s)*(1-s)),add(sc(mid,2*s*(1-s)),sc(to,s*s)));
    const pulse=0.35+0.65*Math.pow(0.5+0.5*Math.sin(s*14-t*8),4);const k=on*pulse*0.55*(Math.abs(awakeR-0.5)*2);
    LINK.p.set(on>0?a:[0,-99,0],i*3);LINK.c.set([0.3*k,0.95*k,1.2*k],i*3);}upd(LINK);}

/* ---------- caméra ---------- */
const SHOTS=[
 [0,4.4,[1.0,0.14,1.55,0.40,0.03,0],[0.85,0.12,1.35,0.42,0.03,0]],
 [4.4,9.0,[0.75,0.34,2.45,0.0,0.12,0.35],[0.50,0.30,2.20,0.0,0.12,0.35]],
 [9.0,13.4,[-0.60,0.32,2.35,0.0,0.12,0.35],[-0.78,0.30,2.10,0.0,0.12,0.35]],
 [13.4,18.0,[0.2,0.35,4.6,0.2,0.30,0],[0.9,0.40,4.3,0.8,0.40,0]],
 [18.0,21.25,[0.0,0.85,2.9,0.05,0.10,-0.15],[0.35,0.75,2.6,0.25,0.12,-0.15]],
 [21.25,24.01,[0.35,0.75,2.6,0.25,0.12,-0.15],[0.5,0.9,3.2,0.6,0.15,-0.2]]];
function camAt(t){const s=SHOTS.find(q=>t>=q[0]&&t<q[1])||SHOTS[SHOTS.length-1];const k=sm(lin(t,s[0],s[1]))*0.85+lin(t,s[0],s[1])*0.15;
  const v=s[2].map((x,i)=>mix(x,s[3][i],k));cam.position.set(v[0],v[1],v[2]);cam.lookAt(v[3],v[4],v[5]);cam.updateMatrixWorld();}

function hide(D){D.o.visible=false;}
function stateScene(t){
  const ph=t*3.2;
  DO1.o.visible=true;DO2.o.visible=false;DO3.o.visible=false;BRAIN.o.visible=false;LINK.o.visible=false;
  let bubOn=0,bubSrc=[0,0,0];
  if(t<4.4){
    // accroche : profil, l'œil droit (côté caméra) s'ouvre et s'allume au tampon
    const eo=0.15+0.85*sm(lin(t,0.6,1.3));
    buildDolphin(DO1,{pos:[0,0,0],yaw:0,pitch:0.02*Math.sin(t*1.1),ph,amp:0.05,eyeL:0,eyeR:eo,glow:1},t);
  } else if(t<13.4){
    // vue de face 3/4 : le cerveau au-dessus de la tête
    let awakeR=1;if(t>=9.0)awakeR=1-sm(lin(t,9.7,10.6));
    const G=buildDolphin(DO1,{pos:[0,-0.25,0],yaw:-Math.PI/2+0.22,pitch:0.03*Math.sin(t*1.2),ph,amp:0.04,
      eyeL:clamp(awakeR*1.2-0.1),eyeR:clamp((1-awakeR)*1.2-0.1),glow:t<5.2?mix(1,0.75,sm(lin(t,4.4,5.2))):0.75},t);
    const on=sm(lin(t,4.6,5.4));BRAIN.o.visible=true;LINK.o.visible=true;buildBrain(G,t,awakeR,on);
  } else if(t<18.0){
    // le groupe nage ; le dauphin du milieu remonte respirer
    const dx=(t-13.4)*0.28;const up=sm(lin(t,14.6,15.6))*(1-sm(lin(t,16.6,17.6)));
    buildDolphin(DO1,{pos:[-0.4+dx,-0.15+up*1.05,0],yaw:0,pitch:0.45*(sm(lin(t,14.4,15.2))-sm(lin(t,15.9,16.7)))-0.1*sm(lin(t,16.4,17.2)),ph,amp:0.07,eyeL:0,eyeR:0.9,glow:1},t);
    DO2.o.visible=true;DO3.o.visible=true;
    buildDolphin(DO2,{pos:[-1.6+dx*1.05,-0.55,-0.9],yaw:0.05,pitch:0.02,ph:ph+1.3,amp:0.07,eyeL:0,eyeR:0.9,glow:0.75},t);
    buildDolphin(DO3,{pos:[0.9+dx*0.95,-0.85,-1.6],yaw:-0.04,pitch:-0.02,ph:ph+2.5,amp:0.07,eyeL:0,eyeR:0.9,glow:0.6},t);
    bubOn=sm(lin(t,15.55,15.75))*(1-sm(lin(t,16.6,17.3)));bubSrc=[-0.4+dx+0.45,-0.15+up*1.05+0.25,0];
  } else {
    // nuance : la mère et son petit (l'œil du petit tourné vers elle) ; fin : ils s'éloignent
    const dx=(t-18)*0.12;const fade=t<21.25?1:mix(1,0.55,sm(lin(t,21.25,22.0)));
    buildDolphin(DO1,{pos:[-0.1+dx,0,0],yaw:0,pitch:0.02*Math.sin(t),ph,amp:0.05,eyeL:0.9,eyeR:0.9,glow:fade},t);
    DO2.o.visible=true;
    buildDolphin(DO2,{pos:[0.05+dx,0.30,-0.42],sc:0.58,yaw:0.0,pitch:0.02*Math.sin(t+1),ph:ph*1.25+0.6,amp:0.06,eyeL:0.1,eyeR:1,glow:fade*0.95},t);
  }
  // eau
  for(let i=0;i<NSN;i++){const [x,y,z,q]=SNU[i];const yy=-2.2+(((y+2.2)-t*0.05*(0.4+q))%4.4+4.4)%4.4;const k=0.07*(0.4+0.6*Math.pow(0.5+0.5*Math.sin(t*0.9+q*30),2));
    SNOW.p.set([x+0.06*Math.sin(t*0.4+q*11),yy,z],i*3);SNOW.c.set([k*0.6,k*0.85,k*1.0],i*3);}upd(SNOW);
  for(let i=0;i<NRAY;i++){const [b,u,q]=RAU[i];const cx=-2.4+b*0.7+0.25*Math.sin(b*3.1),cz=-1.2-((b*1.7)%2.6);const y=SURFY-u*4.0;
    const w=(q-0.5)*(0.10+0.25*u);const k=0.035*(1-u)*(0.6+0.4*Math.sin(t*0.7+b*2));RAYS.p.set([cx+w+u*0.5,y,cz],i*3);RAYS.c.set([k*0.5,k*0.8,k*1.1],i*3);}upd(RAYS);
  for(let i=0;i<NSU;i++){const [x,z,q]=SUU[i];const y=SURFY+0.03*Math.sin(x*3+t*1.4)+0.02*Math.sin(z*4-t*1.1);
    const k=0.06+0.10*Math.pow(0.5+0.5*Math.sin(x*7+z*5+t*2.2+q*3),6);SURF.p.set([x,y,z],i*3);SURF.c.set([k*0.6,k*0.9,k*1.15],i*3);}upd(SURF);
  for(let i=0;i<NBU;i++){const [a,b,c,q]=BUU[i];const s=((q+t*0.9)%1);const p=add(bubSrc,[(a-0.5)*0.25+0.08*Math.sin(s*9+q*7),s*0.9,(b-0.5)*0.2]);
    const k=bubOn*0.5*(1-s);BUB.p.set(bubOn>0?p:[0,-99,0],i*3);BUB.c.set([k*0.8,k*0.95,k*1.1],i*3);}upd(BUB);
  camAt(t);
  bloom.strength=(t>=4.4&&t<13.4)?0.95:0.75;
}
